# EasyDrive — Variáveis de ambiente
# Copie para .env.local e preencha com os valores do seu projeto Supabase
# (Painel Supabase → Settings → API)

VITE_SUPABASE_URL=https://SEU-PROJETO-ID.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Hotmart Integration
# URL para a qual o cliente será redirecionado após comprar na Hotmart
# Configure isto no dashboard da Hotmart: Produto → Configurações → URL de Retorno
# VITE_HOTMART_RETURN_URL=https://seu-app.com/auth/hotmart-success

# Hotmart Product URL (o link que leva o cliente à compra)
# VITE_HOTMART_PRODUCT_URL=https://hotmart.com/product/seu-produto-id
